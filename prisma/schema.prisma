generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model ServiceHeartbeat {
  id         String    @id @default(uuid()) @db.Uuid
  service    String
  instanceId String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  stoppedAt  DateTime? @db.Timestamptz(3)

  @@unique([service, instanceId])
  @@index([service, lastSeenAt])
  @@map("service_heartbeats")
}

model Candle {
  id         String   @id @default(uuid()) @db.Uuid
  pair       String
  timeframe  String
  openTime   BigInt
  closeTime  BigInt
  open       Decimal  @db.Decimal(38, 18)
  high       Decimal  @db.Decimal(38, 18)
  low        Decimal  @db.Decimal(38, 18)
  close      Decimal  @db.Decimal(38, 18)
  volume     Decimal  @db.Decimal(38, 18)
  isClosed   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([pair, timeframe, openTime])
  @@index([pair, timeframe, closeTime])
  @@map("candles")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)

  strategyDefinitions StrategyDefinition[]
  strategyVersions    StrategyVersion[]
  experiments         Experiment[]
  trades              Trade[]
  searchRuns          SearchRun[]
  backtestJobs        BacktestJob[]
  leaderboardEntries  Leaderboard[]

  @@map("users")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime

  @@map("sessions")
}

model StrategyDefinition {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("strategy_definitions")
}

model StrategyVersion {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("strategy_versions")
}

model Experiment {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("experiments")
}

model Trade {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("trades")
}

model SearchRun {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("search_runs")
}

model BacktestJob {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("backtest_jobs")
}

model Leaderboard {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  @@map("leaderboard")
}
