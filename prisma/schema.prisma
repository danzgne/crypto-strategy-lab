generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model ServiceHeartbeat {
  id         String    @id @default(uuid()) @db.Uuid
  service    String
  instanceId String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  stoppedAt  DateTime? @db.Timestamptz(3)

  @@unique([service, instanceId])
  @@index([service, lastSeenAt])
  @@map("service_heartbeats")
}

model Candle {
  id        String   @id @default(uuid()) @db.Uuid
  pair      String
  timeframe String
  openTime  BigInt
  closeTime BigInt
  open      Decimal  @db.Decimal(38, 18)
  high      Decimal  @db.Decimal(38, 18)
  low       Decimal  @db.Decimal(38, 18)
  close     Decimal  @db.Decimal(38, 18)
  volume    Decimal  @db.Decimal(38, 18)
  isClosed  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([pair, timeframe, openTime])
  @@index([pair, timeframe, closeTime])
  @@map("candles")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  strategyDefinitions StrategyDefinition[]
  strategyVersions    StrategyVersion[]
  experiments         Experiment[]
  trades              Trade[]
  searchRuns          SearchRun[]
  backtestJobs        BacktestJob[]
  leaderboard         Leaderboard?

  @@map("users")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime

  @@map("sessions")
}

enum Provenance {
  USER_PROMPT
  WEB_IMPORT
  MANUAL
}

enum RecordKind {
  LIBRARY_ENTRY
  BACKTEST_TARGET
  SEARCH_CANDIDATE
}

model StrategyDefinition {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @db.Uuid
  owner       User       @relation(fields: [ownerId], references: [id])
  name        String
  description String?
  type        String
  source      Provenance
  sourceInput String?    @db.Text
  tags        String[]   @default([])
  recordKind  RecordKind @default(LIBRARY_ENTRY)
  archivedAt  DateTime?  @db.Timestamptz(3)

  versions  StrategyVersion[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@map("strategy_definitions")
}

model StrategyVersion {
  id                   String             @id @default(uuid()) @db.Uuid
  ownerId              String             @db.Uuid
  owner                User               @relation(fields: [ownerId], references: [id])
  strategyDefinitionId String             @db.Uuid
  strategyDefinition   StrategyDefinition @relation(fields: [strategyDefinitionId], references: [id])
  params               Json
  versionTag           String
  libraryVersion       String
  canonicalIdentity    String?

  experiments Experiment[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([ownerId, strategyDefinitionId, canonicalIdentity])
  @@map("strategy_versions")
}

model DatasetSnapshot {
  id                String       @id @default(uuid()) @db.Uuid
  pair              String
  timeframe         String
  startTime         BigInt
  endTime           BigInt
  warmupCandleCount Int
  candles           Json
  fingerprint       String       @unique
  experiments       Experiment[]
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([pair, timeframe, startTime, endTime])
  @@map("dataset_snapshots")
}

model Experiment {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  owner             User             @relation(fields: [ownerId], references: [id])
  strategyVersionId String           @db.Uuid
  strategyVersion   StrategyVersion  @relation(fields: [strategyVersionId], references: [id])
  datasetSnapshotId String?          @db.Uuid
  datasetSnapshot   DatasetSnapshot? @relation(fields: [datasetSnapshotId], references: [id])

  pair                   String
  timeframe              String  @default("1m")
  startTime              BigInt
  endTime                BigInt
  initialInvestment      Decimal @db.Decimal(38, 18)
  transactionCost        Decimal @db.Decimal(38, 18)
  slippage               Decimal @db.Decimal(38, 18)
  simulationRulesVersion String  @default("historical-v1")
  evaluatorVersion       String  @default("default-v1")

  score                Decimal? @db.Decimal(38, 18)
  return               Decimal? @db.Decimal(38, 18)
  maxDrawdown          Decimal? @db.Decimal(38, 18)
  winRate              Decimal? @db.Decimal(38, 18)
  maxDrawdownAmount    Decimal? @db.Decimal(38, 18)
  totalTrades          Int?
  wins                 Int?
  losses               Int?
  totalProfit          Decimal? @db.Decimal(38, 18)
  profitFactor         Decimal? @db.Decimal(38, 18)
  profitFactorInfinite Boolean  @default(false)
  sharpeRatio          Decimal? @db.Decimal(38, 18)

  trades             Trade[]
  backtestJob        BacktestJob?
  leaderboardEntries LeaderboardEntry[]
  searchRunId        String?            @db.Uuid
  searchRun          SearchRun?         @relation(fields: [searchRunId], references: [id], onDelete: SetNull)
  fingerprint        String?
  isPinned           Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@index([ownerId, createdAt])
  @@index([searchRunId])
  @@index([isPinned])
  @@map("experiments")
}

model Trade {
  id           String     @id @default(uuid()) @db.Uuid
  ownerId      String     @db.Uuid
  owner        User       @relation(fields: [ownerId], references: [id])
  experimentId String     @db.Uuid
  experiment   Experiment @relation(fields: [experimentId], references: [id])

  pair            String
  entryTime       BigInt
  exitTime        BigInt?
  direction       String
  investment      Decimal  @db.Decimal(38, 18)
  entryPrice      Decimal  @db.Decimal(38, 18)
  stopLoss        Decimal? @db.Decimal(38, 18)
  takeProfit      Decimal? @db.Decimal(38, 18)
  exitPrice       Decimal? @db.Decimal(38, 18)
  transactionCost Decimal  @db.Decimal(38, 18)
  slippage        Decimal  @db.Decimal(38, 18)
  profit          Decimal? @db.Decimal(38, 18)
  exitReason      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([experimentId])
  @@map("trades")
}

enum SearchRunStatus {
  RUNNING
  STOPPING
  COMPLETED
  FAILED
}

model SearchRun {
  id                       String          @id @default(uuid()) @db.Uuid
  ownerId                  String          @db.Uuid
  owner                    User            @relation(fields: [ownerId], references: [id])
  status                   SearchRunStatus @default(RUNNING)
  algorithm                String          @default("random-v1")
  seed                     Int             @default(0)
  nextGenerationOrdinal    Int             @default(1)
  searchConfig             Json
  stopReason               String?
  acceptedCandidates       Int             @default(0)
  bestScore                Decimal?        @db.Decimal(38, 18)
  consecutiveNoImprovement Int             @default(0)
  consecutiveFailures      Int             @default(0)
  inFlightJobs             Int             @default(0)
  startedAt                DateTime        @default(now()) @db.Timestamptz(3)
  stoppedAt                DateTime?       @db.Timestamptz(3)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)

  experiments  Experiment[]
  backtestJobs BacktestJob[]

  @@index([ownerId, status])
  @@map("search_runs")
}

enum JobStatus {
  PENDING
  CLAIMED
  COMPLETED
  FAILED
}

enum JobFailureCategory {
  TRANSIENT
  PERMANENT
}

model BacktestJob {
  id              String              @id @default(uuid()) @db.Uuid
  ownerId         String              @db.Uuid
  owner           User                @relation(fields: [ownerId], references: [id])
  experimentId    String              @unique @db.Uuid
  experiment      Experiment          @relation(fields: [experimentId], references: [id])
  searchRunId     String?             @db.Uuid
  searchRun       SearchRun?          @relation(fields: [searchRunId], references: [id], onDelete: SetNull)
  status          JobStatus           @default(PENDING)
  claimedAt       DateTime?           @db.Timestamptz(3)
  workerId        String?
  leaseToken      String?             @db.Uuid
  leaseExpiresAt  DateTime?           @db.Timestamptz(3)
  retryCount      Int                 @default(0)
  error           String?             @db.Text
  failureCategory JobFailureCategory?
  nextEligibleAt  DateTime?           @db.Timestamptz(3)
  failedAt        DateTime?           @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, claimedAt])
  @@index([status, nextEligibleAt])
  @@index([searchRunId])
  @@map("backtest_jobs")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @unique @db.Uuid
  name           String
  version        Int
  occurredAt     DateTime  @db.Timestamptz(3)
  payload        Json
  publishedAt    DateTime? @db.Timestamptz(3)
  claimToken     String?   @db.Uuid
  claimExpiresAt DateTime? @db.Timestamptz(3)
  attemptCount   Int       @default(0)
  lastError      String?   @db.Text
  nextAttemptAt  DateTime? @db.Timestamptz(3)
  deadLetteredAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@index([publishedAt, deadLetteredAt, nextAttemptAt, createdAt])
  @@map("event_outbox")
}

model Leaderboard {
  id            String                    @id @default(uuid()) @db.Uuid
  ownerId       String                    @unique @db.Uuid
  owner         User                      @relation(fields: [ownerId], references: [id])
  entries       LeaderboardEntry[]
  eventReceipts LeaderboardEventReceipt[]
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  @@map("leaderboard")
}

model LeaderboardEntry {
  id                  String      @id @default(uuid()) @db.Uuid
  leaderboardId       String      @db.Uuid
  leaderboard         Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  experimentId        String      @db.Uuid
  experiment          Experiment  @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  rank                Int
  strategyVersionId   String      @db.Uuid
  strategyDisplayName String
  memberStrategies    Json
  pair                String
  timeframe           String
  startTime           BigInt
  endTime             BigInt
  score               Decimal     @db.Decimal(38, 18)
  return              Decimal     @db.Decimal(38, 18)
  winRate             Decimal     @db.Decimal(38, 18)
  maxDrawdown         Decimal     @db.Decimal(38, 18)
  totalProfit         Decimal     @db.Decimal(38, 18)
  totalTrades         Int
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([leaderboardId, experimentId])
  @@index([leaderboardId, rank])
  @@map("leaderboard_entries")
}

model LeaderboardEventReceipt {
  id            String      @id @default(uuid()) @db.Uuid
  leaderboardId String      @db.Uuid
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  eventId       String      @unique @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([leaderboardId, createdAt])
  @@map("leaderboard_event_receipts")
}

enum NewsProviderType {
  RSS
  WEBSITE
  HTML
}

enum CrawlStatus {
  SUCCESS
  FAILURE
}

enum TemplateVersionStatus {
  PROPOSED
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum NewsEventType {
  ETF_FUND_FLOW
  PROTOCOL_UPGRADE
  REGULATION
  PARTNERSHIP
  MARKET_TREND
  OTHER
}

model NewsSource {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String
  url                        String
  providerType               NewsProviderType
  isActive                   Boolean                     @default(true)
  config                     Json?
  newsItems                  NewsItem[]
  crawlLogs                  NewsCrawlAttempt[]
  extractionTemplateVersions ExtractionTemplateVersion[]
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)

  @@map("news_sources")
}

model NewsItem {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  content        String          @db.Text
  source         String
  url            String          @unique
  publishedAt    DateTime        @db.Timestamptz(3)
  relatedCoins   String[]        @default([])
  sentimentLabel SentimentLabel?
  sentimentScore Decimal?        @db.Decimal(38, 18)
  eventType      NewsEventType?
  newsSourceId   String?         @db.Uuid
  newsSource     NewsSource?     @relation(fields: [newsSourceId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([publishedAt(sort: Desc)])
  @@index([newsSourceId])
  @@map("news_items")
}

model NewsCrawlAttempt {
  id                 String                     @id @default(uuid()) @db.Uuid
  newsSourceId       String                     @db.Uuid
  newsSource         NewsSource                 @relation(fields: [newsSourceId], references: [id], onDelete: Cascade)
  status             CrawlStatus
  itemsFound         Int                        @default(0)
  itemsPersisted     Int                        @default(0)
  errorMessage       String?                    @db.Text
  templateVersionId  String?                    @db.Uuid
  templateVersion    ExtractionTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  emptyFieldRate     Decimal?                   @db.Decimal(5, 4)
  malformedFieldRate Decimal?                   @db.Decimal(5, 4)
  avgConfidence      Decimal?                   @db.Decimal(4, 3)
  crawledAt          DateTime                   @default(now()) @db.Timestamptz(3)

  @@index([newsSourceId, crawledAt])
  @@index([templateVersionId, crawledAt])
  @@map("news_crawl_attempts")
}

model ExtractionTemplateVersion {
  id                          String                      @id @default(uuid()) @db.Uuid
  newsSourceId                String                      @db.Uuid
  newsSource                  NewsSource                  @relation(fields: [newsSourceId], references: [id], onDelete: Cascade)
  version                     Int
  status                      TemplateVersionStatus
  template                    Json
  confidence                  Decimal                     @db.Decimal(4, 3)
  generatedBy                 String
  basedOnVersionId            String?                     @db.Uuid
  basedOnVersion              ExtractionTemplateVersion?  @relation("TemplateVersionBasedOn", fields: [basedOnVersionId], references: [id])
  supersedes                  ExtractionTemplateVersion[] @relation("TemplateVersionBasedOn")
  projectedEmptyFieldRate     Decimal?                    @db.Decimal(5, 4)
  projectedMalformedFieldRate Decimal?                    @db.Decimal(5, 4)
  activatedAt                 DateTime?                   @db.Timestamptz(3)
  createdAt                   DateTime                    @default(now()) @db.Timestamptz(3)
  crawlAttempts               NewsCrawlAttempt[]

  @@unique([newsSourceId, version])
  @@index([newsSourceId, status])
  @@map("extraction_template_versions")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}
