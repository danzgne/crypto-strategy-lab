# OS
.DS_Store

# Claude Code / agent-skills local state.
# NOTE: .claude/skills and .agents/skills are each developer's own installed
# copy of the Matt Pocock skill pack, not shared repo content. skills-lock.json
# stays tracked as the pinned baseline (source + hash per skill); everyone
# installs from it locally and can customize their own copy from there without
# it becoming a shared-repo diff.
.claude/skills/
.agents/skills/
.claude/worktrees/
.claude/settings.local.json

# Node / TypeScript (apps/backend, apps/backtest-worker, apps/frontend, packages/shared — see ADR-0001)
node_modules/
dist/
build/
*.tsbuildinfo
.pnpm-store/

# Python (apps/sentiment-service — see ADR-0001)
__pycache__/
*.pyc
.venv/
venv/

# Env / secrets
.env
.env.*
!.env.example
