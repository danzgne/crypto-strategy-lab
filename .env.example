# Copy to .env for running the workspace directly on the host.
NODE_ENV=development
DATABASE_URL=postgresql://crypto_lab:crypto_lab@localhost:5434/crypto_strategy_lab?schema=public

POSTGRES_DB=crypto_strategy_lab
POSTGRES_PASSWORD=crypto_lab
POSTGRES_PORT=5434
POSTGRES_USER=crypto_lab

BACKEND_HOST=0.0.0.0
BACKEND_INSTANCE_ID=backend-local
BACKEND_PORT=3100
BACKTEST_MAX_SELECTED_CANDLES=100000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Optional; leave blank to run the backend without that LLM vendor.
GEMINI_API_KEY=
GROQ_API_KEY=

# Next.js host commands read PORT; Compose publishes FRONTEND_PORT instead.
PORT=3000

WORKER_ID=backtest-worker-local
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=300000

NEXT_PUBLIC_BACKEND_URL=http://localhost:3100
